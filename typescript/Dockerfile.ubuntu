# syntax=docker/dockerfile:1
# Identical build stage to the alpine variant, so dist/ is byte-identical.
FROM node:22-alpine3.22 AS build
WORKDIR /src
COPY package.json tsconfig.json ./
RUN npm install --no-audit --no-fund
COPY src ./src
RUN npm run build

# Ubuntu 26.04 ships Node 22.22 in its own repo, so the runtime major matches
# the alpine variant with no third-party apt source needed.
FROM ubuntu:26.04
RUN ok=0; for i in 1 2 3 4 5; do apt-get update && apt-get install -y --no-install-recommends nodejs \
      && { ok=1; break; }; sleep 3; done; [ "$ok" = 1 ] \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/dist ./dist
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["node", "/app/dist/server.js"]
