# syntax=docker/dockerfile:1
# Ubuntu 26.04 ships CPython 3.14.3, matching the alpine variant's 3.14.
FROM ubuntu:26.04
RUN ok=0; for i in 1 2 3 4 5; do apt-get update && apt-get install -y --no-install-recommends python3 \
      && { ok=1; break; }; sleep 3; done; [ "$ok" = 1 ] \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY app.py ./
ENV PORT=8080 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["python3", "/app/app.py"]
