# syntax=docker/dockerfile:1
# CPython 3.14 -- matches the 3.14.3 that Ubuntu 26.04 ships, so the two
# variants differ only in base image and libc.
FROM python:3.14-alpine3.22
WORKDIR /app
COPY app.py ./
ENV PORT=8080 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["python3", "/app/app.py"]
