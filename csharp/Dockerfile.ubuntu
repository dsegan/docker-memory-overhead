# syntax=docker/dockerfile:1
# -resolute == Ubuntu 26.04. Same .NET 10 as the alpine variant.
FROM mcr.microsoft.com/dotnet/sdk:10.0-resolute AS build
WORKDIR /src
COPY hello.csproj ./
RUN dotnet restore
COPY Program.cs ./
RUN dotnet publish -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0-resolute
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_HTTP_PORTS=8080 DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["dotnet", "/app/hello.dll"]
