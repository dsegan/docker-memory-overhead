# syntax=docker/dockerfile:1
# .NET 10 (not 9): Microsoft publishes no Ubuntu 26.04 base for .NET 9, and
# both variants must share one runtime version to be comparable.
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine3.22 AS build
WORKDIR /src
COPY hello.csproj ./
RUN dotnet restore
COPY Program.cs ./
RUN dotnet publish -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine3.22
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_HTTP_PORTS=8080 DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["dotnet", "/app/hello.dll"]
